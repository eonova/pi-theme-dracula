{
  "schemaVersion": 1,
  "id": "local.pi-theme-dracula",
  "name": "pi-theme-dracula",
  "version": "0.1.0",
  "description": "pi-theme-dracula — PI-Desktop Dracula theme plugin.",
  "main": "main.js",
  "ui": {
    "panel": "renderer/index.html",
    "title": "pi-theme-dracula"
  },
  "contributes": {
    "commands": [
      {
        "id": "pi-theme-dracula.open",
        "title": "pi-theme-dracula: Open Panel",
        "keywords": [
          "pi-theme-dracula"
        ]
      }
    ]
  },
  "permissions": [
    "ui.panel"
  ],
  "engines": {
    "piDesktop": ">=0.1.0"
  },
  "activationEvents": [
    "onCommand:pi-theme-dracula.open",
    "onStartup"
  ]
}
